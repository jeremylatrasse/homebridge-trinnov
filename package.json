{
  "name": "homebridge-trinnov-altitude",
  "version": "1.0.6",
  "description": "Homebridge dynamic platform plugin for Trinnov Altitude32 (and Altitude16) high-end audio processors over Ethernet.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeremylatrasse/homebridge-trinnov.git"
  },
  "bugs": {
    "url": "https://github.com/jeremylatrasse/homebridge-trinnov/issues"
  },
  "homepage": "https://github.com/jeremylatrasse/homebridge-trinnov#readme",
  "keywords": [
    "homebridge-plugin",
    "trinnov",
    "altitude",
    "altitude32",
    "altitude16",
    "audio-processor",
    "home-theater",
    "av-receiver"
  ],
  "engines": {
    "node": ">=18.0.0",
    "homebridge": ">=1.6.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "config.schema.json",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "check": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "npm run build && node test-trinnov.mjs",
    "bump": "npm version patch --no-git-tag-version",
    "release": "npm run bump && npm run build && node test-trinnov.mjs",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.12.0",
    "homebridge": "^1.8.0",
    "typescript": "^5.4.0"
  }
}
